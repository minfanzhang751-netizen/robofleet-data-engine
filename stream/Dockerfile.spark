# Spark Structured Streaming image (Module 3 primary path).
# Build from repo root:
#   docker build -t robofleet-spark:local -f stream/Dockerfile.spark .
#
# Build-time spark-submit warmup downloads the Kafka connector into SPARK_IVY_DIR
# so the Pod can start without outbound Maven access. Runtime ENTRYPOINT is
# entrypoint-spark.sh → spark-submit → spark_window_job.py.
# docker.io/bitnami/spark was removed; 3.5.3 is archived at bitnamilegacy.
FROM bitnamilegacy/spark:3.5.3

USER root
WORKDIR /opt/spark-job

ENV SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3
ENV SPARK_IVY_DIR=/opt/bitnami/spark/ivy

RUN mkdir -p "${SPARK_IVY_DIR}" \
  && printf 'print("kafka-connector-warmup")\n' > /tmp/warmup.py \
  && /opt/bitnami/spark/bin/spark-submit \
       --master local[1] \
       --packages "${SPARK_KAFKA_PACKAGE}" \
       --conf "spark.jars.ivy=${SPARK_IVY_DIR}" \
       /tmp/warmup.py \
  && rm -f /tmp/warmup.py \
  && chmod -R g+rwX "${SPARK_IVY_DIR}"

COPY stream/spark_window_job.py /opt/spark-job/spark_window_job.py
COPY stream/entrypoint-spark.sh /opt/spark-job/entrypoint-spark.sh
RUN chmod +x /opt/spark-job/entrypoint-spark.sh \
  && chown -R 1001:1001 /opt/spark-job "${SPARK_IVY_DIR}"

ENV KAFKA_BOOTSTRAP_SERVERS=robofleet-kafka-bootstrap.kafka.svc:9092
ENV KAFKA_INPUT_TOPIC=robot-telemetry
ENV KAFKA_OUTPUT_TOPIC=robot-telemetry-windows
ENV SPARK_CHECKPOINT_DIR=/checkpoints/robot-telemetry-windows
ENV SPARK_MASTER=local[2]

USER 1001
ENTRYPOINT ["/opt/spark-job/entrypoint-spark.sh"]
