# Baseline window worker image (Module 3 comparison path).
# Build from repo root:
#   docker build -t robofleet-baseline:local -f stream/Dockerfile.baseline .
# Entrypoint runs the handwritten Kafka consumer using EventTimeWindowEngine.
FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY stream /app/stream
ENV PYTHONPATH=/app
# In-cluster Kafka defaults (Deployment may override).
ENV KAFKA_BOOTSTRAP_SERVERS=robofleet-kafka-bootstrap.kafka.svc:9092
ENV KAFKA_INPUT_TOPIC=robot-telemetry
ENV KAFKA_OUTPUT_TOPIC=robot-telemetry-windows-baseline
ENV KAFKA_GROUP_ID=robofleet-baseline-windows

CMD ["python", "-m", "stream.baseline_window"]
